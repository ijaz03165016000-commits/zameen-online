rules_version = '2';
// ====================================================================
// Zameen Online — Production Firestore Security Rules
// Roles: super_admin, admin, district_admin, dealer, user
// Publish in Firebase Console → Firestore Database → Rules → Publish
// ====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user')
        : 'user';
    }

    function userDistricts() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedDistricts', [])
        : [];
    }

    function userSingleDistrict() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('district', '')
        : '';
    }

    // Exact owner email whitelist — never wildcard-match names/emails so
    // private seller test accounts remain genuine private sellers.
    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'ijaz03165016000@gmail.com',
          'admin@zameen.online',
          'info@zameen.online'
        ];
    }

    function isGlobalAdmin() {
      return signedIn() && (
        isOwnerEmail() ||
        userRole() in ['super_admin', 'admin']
      );
    }

    function isStaff() {
      return signedIn() && (
        isGlobalAdmin() ||
        userRole() == 'district_admin'
      );
    }

    function isDistrictAdminFor(city) {
      return signedIn() && (
        isGlobalAdmin() ||
        (userRole() == 'district_admin' && (
          (userDistricts() is list && city in userDistricts()) ||
          (userSingleDistrict() is string && userSingleDistrict() == city)
        ))
      );
    }

    function ownsListing(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/listings/$(id))
        && get(/databases/$(database)/documents/listings/$(id)).data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------
    match /users/{uid} {
      // Users read their own doc; staff can read all user docs
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Self-signup can only create 'user' or 'dealer' on Basic plan;
      // Global Admins can create any user doc.
      allow create: if isGlobalAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role in ['user', 'dealer']
                        && request.resource.data.get('plan', 'Basic') == 'Basic');

      // Global Admins can manage any user's role, plan, and districts.
      // Regular users can only edit safe profile fields (name, phone, city).
      allow update: if isGlobalAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['role', 'plan', 'assignedDistricts', 'district', 'email', 'isSuperAdmin']));

      allow delete: if isGlobalAdmin();
    }

    // -------------------------------------------------------------
    // LISTINGS COLLECTION
    // -------------------------------------------------------------
    match /listings/{id} {
      // Public sees approved ads; Staff sees ALL ads (including pending & rejected);
      // Owners see their own ads regardless of status.
      allow read: if resource.data.status == 'approved'
                  || isStaff()
                  || (signedIn() && resource.data.ownerId == request.auth.uid);

      // Private sellers & dealers MUST create ads as 'pending' and not featured.
      // Global Admins may create pre-approved ads directly.
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && (
                      isGlobalAdmin()
                      || (request.resource.data.status == 'pending'
                          && request.resource.data.get('featured', false) == false)
                    );

      // Update / Moderation:
      // 1. Global Admins can approve, reject, feature, or edit any ad
      // 2. District Admins can moderate ads in their assigned cities
      // 3. Owners can edit their own ad — resets to 'pending' and cannot alter ownerId or featured
      // 4. Public can increment views by 1
      allow update: if isGlobalAdmin()
                    || isDistrictAdminFor(resource.data.get('city', ''))
                    || (signedIn()
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status == 'pending'
                        && request.resource.data.get('featured', false) == resource.data.get('featured', false))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                        && request.resource.data.views is number
                        && request.resource.data.views == resource.data.get('views', 0) + 1);

      allow delete: if isGlobalAdmin()
                    || isDistrictAdminFor(resource.data.get('city', ''))
                    || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // -------------------------------------------------------------
    // MEDIA (Thumbs & Photos)
    // -------------------------------------------------------------
    match /thumbs/{id} {
      allow read: if true;
      allow write: if isStaff() || ownsListing(id);
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isStaff() || ownsListing(id);
    }

    // -------------------------------------------------------------
    // DEALERS DIRECTORY
    // -------------------------------------------------------------
    match /dealers/{id} {
      allow read: if true;
      allow create: if isStaff()
                    || (signedIn()
                        && request.auth.uid == id
                        && request.resource.data.get('verified', false) == false
                        && request.resource.data.get('plan', 'Basic') == 'Basic');
      allow update: if isStaff()
                    || (signedIn()
                        && request.auth.uid == id
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'plan']));
      allow delete: if isGlobalAdmin();
    }

    // -------------------------------------------------------------
    // SERVICES DIRECTORY
    // -------------------------------------------------------------
    match /services/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // -------------------------------------------------------------
    // BUYER INQUIRIES
    // -------------------------------------------------------------
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['listingId', 'name', 'phone', 'message'])
                    && request.resource.data.get('read', false) == false
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isStaff()
                                  || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
  }
}
