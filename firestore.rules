rules_version = '2';
// ====================================================================
// Zameen Online — Robust Enterprise Firestore Security Rules
// Roles: super_admin, admin, district_admin, dealer, user
// ====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { 
      return request.auth != null; 
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerEmail() {
      return signedIn() && (
        request.auth.token.email.matches('(?i).*ijaz.*') ||
        request.auth.token.email == 'admin@zameen.online' ||
        request.auth.token.email == 'info@zameen.online' ||
        request.auth.token.email == 'ijaz03165016000@gmail.com'
      );
    }

    function isGlobalAdmin() {
      return signedIn() && (
        isOwnerEmail() ||
        getUserDoc().role == 'super_admin' || 
        getUserDoc().role == 'admin'
      );
    }

    function isStaff() {
      return signedIn() && (
        isGlobalAdmin() || 
        getUserDoc().role == 'district_admin'
      );
    }

    function isDistrictAdmin(city) {
      return signedIn() && (
        isGlobalAdmin() ||
        (getUserDoc().role == 'district_admin' && (
          (getUserDoc().assignedDistricts is list && city in getUserDoc().assignedDistricts) ||
          (getUserDoc().district is string && getUserDoc().district == city)
        ))
      );
    }

    function ownsListing(id) {
      return signedIn() && get(/databases/$(database)/documents/listings/$(id)).data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------
    match /users/{uid} {
      // User can read own doc; all staff (admin, district admin) can read user docs
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Anyone signed in can create their own user document
      allow create: if signedIn() && request.auth.uid == uid;

      // Global Admins can update any user doc (assign roles, packages, districts)
      // Regular users can only update their own profile (not role, plan, or assignedDistricts)
      allow update: if isGlobalAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'assignedDistricts']));

      allow delete: if isGlobalAdmin();
    }

    // -------------------------------------------------------------
    // LISTINGS COLLECTION
    // -------------------------------------------------------------
    match /listings/{id} {
      // Public sees approved ads; Staff sees all ads to moderate; owners see their own
      allow read: if resource.data.status == 'approved'
                  || isStaff()
                  || (signedIn() && resource.data.ownerId == request.auth.uid);

      // Create: Users create ads as "pending"; Admins can create approved ads
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;

      // Update / Moderation:
      // Global Admins can update any ad
      // District Admins can update ads in their assigned cities
      // Owners can update their own ads
      // Public can increment views
      allow update: if isGlobalAdmin()
                    || (getUserDoc().role == 'district_admin' && isDistrictAdmin(resource.data.city))
                    || (signedIn() && resource.data.ownerId == request.auth.uid)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));

      // Deletions
      allow delete: if isGlobalAdmin() 
                    || (getUserDoc().role == 'district_admin' && isDistrictAdmin(resource.data.city))
                    || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // -------------------------------------------------------------
    // MEDIA (Thumbs & Photos)
    // -------------------------------------------------------------
    match /thumbs/{id} {
      allow read: if true;
      allow write: if isStaff() || ownsListing(id);
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isStaff() || ownsListing(id);
    }

    // -------------------------------------------------------------
    // DEALERS DIRECTORY
    // -------------------------------------------------------------
    match /dealers/{id} {
      allow read: if true;
      // Allow dealers to create/update own profile; Allow staff to manage all dealers
      allow create, update: if isStaff() || (signedIn() && request.auth.uid == id);
      allow delete: if isGlobalAdmin();
    }

    // -------------------------------------------------------------
    // SERVICES DIRECTORY
    // -------------------------------------------------------------
    match /services/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // -------------------------------------------------------------
    // BUYER INQUIRIES
    // -------------------------------------------------------------
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isStaff() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
  }
}
